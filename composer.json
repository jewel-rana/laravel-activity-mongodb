{
    "name": "rajtika/mongovity",
    "description": "Application activity log with mongodb",
    "type": "library",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0",
        "mongodb/laravel-mongodb": "^5.2"
    },
    "license": "MIT",
    "autoload": {
        "files": [
            "src/Helper/Activity.php"
        ],
        "psr-4": {
            "Rajtika\\Mongovity\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Jewel Rana",
            "email": "jewelrana.dev@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Rajtika\\Mongovity\\MongovityServiceProvider"
            ],
            "aliases": {
                "Mongovity": "Rajtika\\Mongovity\\Facades\\Mongovity"
            }
        }
    }
}
